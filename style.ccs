*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{

background:#050816;

height:100vh;

overflow:hidden;

display:flex;

justify-content:center;

align-items:center;

color:white;

}

/* Aurora */

.aurora{

position:fixed;

width:700px;

height:700px;

background:radial-gradient(circle,#4f8cff55,transparent 70%);

filter:blur(120px);

animation:auroraMove 12s ease-in-out infinite alternate;

z-index:0;

}

@keyframes auroraMove{

0%{
transform:translate(-200px,-150px);
}

100%{
transform:translate(250px,120px);
}

}

/* Stars */

#stars{

position:fixed;

width:100%;

height:100%;

z-index:0;

}

.star{

position:absolute;

width:2px;

height:2px;

background:white;

border-radius:50%;

animation:blink 2s infinite;

}

@keyframes blink{

50%{
opacity:.2;
}

}

/* Container */

.container{

position:relative;

z-index:2;

width:100%;

display:flex;

justify-content:center;

}

/* Card */

.card{

width:700px;

max-width:90%;

padding:50px;

background:rgba(255,255,255,.08);

backdrop-filter:blur(18px);

border:1px solid rgba(255,255,255,.15);

border-radius:28px;

text-align:center;

box-shadow:0 15px 40px rgba(0,0,0,.35);

}

.card h1{

font-size:42px;

margin-bottom:20px;

}

.card p{

font-size:21px;

line-height:1.8;

min-height:90px;

opacity:.9;

}

/* Buttons */

.buttons{

margin-top:35px;

display:flex;

justify-content:center;

gap:20px;

flex-wrap:wrap;

}

button{

padding:16px 32px;

border:none;

border-radius:999px;

cursor:pointer;

font-size:17px;

font-weight:600;

background:white;

color:#18345e;

transition:.35s;

}

button:hover{

transform:translateY(-4px);

box-shadow:0 12px 25px rgba(255,255,255,.25);

}

/* Mobile */

@media(max-width:700px){

.card{

padding:35px;

}

.card h1{

font-size:30px;

}

.card p{

font-size:18px;

}

button{

width:100%;

}

}